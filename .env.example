# =============================================================================
# KoAkademy — Local Development Environment
# =============================================================================
# 1. Copy to .env and edit as needed:
#      copy .env.example .env   (Windows)
#      cp .env.example .env     (macOS / Linux)
# 2. Create the SQLite database file (the default driver below):
#      touch database/database.sqlite
# 3. Generate an application key:
#      php artisan key:generate
# 4. Run migrations, then start coding:
#      php artisan migrate
#
# Everything here runs out of the box without external services — no Redis,
# PostgreSQL, MinIO, Pusher, or third-party API keys are required.

# --- Application ----------------------------------------------------------
APP_NAME="KoAkademy"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_URL=http://localhost

# Leave empty; run `php artisan key:generate`.
APP_KEY=

# --- Database (default: local SQLite) -------------------------------------
# For PostgreSQL instead, comment out DB_CONNECTION and uncomment the lines below.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=koakademy
# DB_USERNAME=
# DB_PASSWORD=

# --- Cache, session & queue (database-backed; no Redis required) ---------
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# --- Mail (log to storage/logs; switch to smtp/mailpit as needed) ---------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=info@koakademy.edu
MAIL_FROM_NAME="${APP_NAME}"

# --- Broadcasting & realtime (log; add Pusher/reverb when needed) ---------
BROADCAST_CONNECTION=log

# --- File storage ----------------------------------------------------------
FILESYSTEM_DISK=local

# --- Logging ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Portals & assets ---------------------------------------------------------
# Both the public portal and the admin panel (served at /admin) default to
# localhost; override with real domains only in production.
PORTAL_HOST=localhost
ADMIN_HOST=localhost
VITE_APP_NAME="${APP_NAME}"
DOCUMENTATION_URL=https://koakademy.github.io/koakademy

# --- Developer observability (off by default for a minimal local setup) ----
TELESCOPE_ENABLED=false
PULSE_ENABLED=false