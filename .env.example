# =============================================================================
# KoAkademy — Local Development Environment
# =============================================================================
# 1. Copy to .env and edit as needed:
#      copy .env.example .env   (Windows)
#      cp .env.example .env     (macOS / Linux)
# 2. Create the SQLite database file (the default driver below):
#      touch database/database.sqlite
# 3. Generate an application key:
#      php artisan key:generate
# 4. Run migrations, then start coding:
#      php artisan migrate
#
# Everything here runs out of the box without external services — no Redis,
# PostgreSQL, MinIO, Pusher, or third-party API keys are required.

# --- Application ----------------------------------------------------------
APP_NAME="KoAkademy"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_URL=http://localhost

# Leave empty; run `php artisan key:generate`.
APP_KEY=

# --- Database (default: local SQLite) -------------------------------------
# For PostgreSQL instead, comment out DB_CONNECTION and uncomment the lines below.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=koakademy
# DB_USERNAME=
# DB_PASSWORD=

# --- Cache, session & queue (database-backed; no Redis required) ---------
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# --- Mail (log to storage/logs; switch to smtp/mailpit as needed) ---------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=info@koakademy.edu
MAIL_FROM_NAME="${APP_NAME}"

# --- Broadcasting & realtime (log; add Pusher/reverb when needed) ---------
BROADCAST_CONNECTION=log

# --- File storage ----------------------------------------------------------
FILESYSTEM_DISK=local

# --- Logging ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Portals & assets ---------------------------------------------------------
# Both the public portal and the admin panel (served at /admin) default to
# localhost; override with real domains only in production.
PORTAL_HOST=localhost
ADMIN_HOST=localhost
VITE_APP_NAME="${APP_NAME}"
DOCUMENTATION_URL=https://koakademy.github.io/koakademy

# Vendor-installed Composer modules are scanned by default.
MODULE_SCAN_VENDOR=true

# Optional signed module catalog; disabled unless explicitly enabled.
MODULE_MARKETPLACE_ENABLED=false
MODULE_REGISTRY_URL=
MODULE_REGISTRY_CACHE_TTL=3600
MODULE_REGISTRY_REQUIRE_SIGNATURE=true
MODULE_REGISTRY_PUBLIC_KEY=
MODULE_REGISTRY_PUBLIC_KEY_FILE=

# --- Developer observability (off by default for a minimal local setup) ----
TELESCOPE_ENABLED=false
PULSE_ENABLED=false

# --- Error reporting (Sentry; optional) -------------------------------------
# The DSN can also be configured at runtime in the admin panel under
# System Settings > Error Reporting, which overrides these values.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENABLE_LOGS=false
SENTRY_FRONTEND_ENABLED=false
SENTRY_FRONTEND_DSN=
SENTRY_FRONTEND_SCRIPT=
SENTRY_FRONTEND_TRACES_SAMPLE_RATE=0.1
SENTRY_FRONTEND_REPLAYS_SESSION_SAMPLE_RATE=0
SENTRY_FRONTEND_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# Additional error reporting providers (also configurable in the admin panel
# under System Settings > Error Reporting; each needs its SDK installed).
FLARE_KEY=
BUGSNAG_API_KEY=
HONEYBADGER_API_KEY=
