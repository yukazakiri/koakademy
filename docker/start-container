#!/usr/bin/env sh
set -e

container_mode=${CONTAINER_MODE:-"http"}
app_env=$(printf '%s' "${APP_ENV:-production}" | tr '[:upper:]' '[:lower:]')
database_connection=$(printf '%s' "${DB_CONNECTION:-}" | tr '[:upper:]' '[:lower:]')

station_enabled=true
export ASSESSMENT_EXPORT_PROCESSES="${ASSESSMENT_EXPORT_PROCESSES:-2}"
export ASSESSMENT_EXPORT_EVENT_PROCESSES="${ASSESSMENT_EXPORT_EVENT_PROCESSES:-1}"
export ASSESSMENT_EXPORT_CONNECTION="${ASSESSMENT_EXPORT_CONNECTION:-assessment-pdf}"
export ASSESSMENT_EXPORT_QUEUE="${ASSESSMENT_EXPORT_QUEUE:-assessment-pdf}"
export ASSESSMENT_EXPORT_EVENT_QUEUE="${ASSESSMENT_EXPORT_EVENT_QUEUE:-assessment-events}"
export ASSESSMENT_EXPORT_WORKER_TIMEOUT="${ASSESSMENT_EXPORT_WORKER_TIMEOUT:-1900}"
export ASSESSMENT_EXPORT_WORKER_MEMORY="${ASSESSMENT_EXPORT_WORKER_MEMORY:-2048}"

# Schedule Scout settings sync after services are already running under
# supervisord. Full Scout imports are intentionally never run from container
# startup; reindexing should be handled out-of-band for Swarm deployments.
schedule_scout_settings_post_start() {
    if [ "${run_scout_settings}" != "true" ]; then
        return 0
    fi

    echo "Scheduling Scout settings sync post-start..."

    (
        sleep 20
        echo "[scout-settings] Starting Scout settings sync at $(date -Iseconds)"
        run_scout_settings_sync
        echo "[scout-settings] Scout settings sync finished at $(date -Iseconds)"
    ) >/proc/1/fd/1 2>&1 </dev/null &

    disown 2>/dev/null || true
}
octane_server=${OCTANE_SERVER:-""}

# Production deployment settings
# RUN_MIGRATIONS: Opt in to migrations on container start (not recommended for production)
# PRODUCTION_SEEDERS: Comma-separated list of production-safe seeders to run
# RUN_DOCKER_SCRIPTS: Set to "true" to run scripts in docker-scripts folder on container start
# RUN_SCOUT_SETTINGS: Set to "true" to sync Scout index settings after services boot (post-start). Default "true".
# Scout reindexing should be run out-of-band when needed.
# RUN_OPTIMIZE: "foreground" (default) | "background" | "false" — rebuild Laravel caches.
# FORCE_OPTIMIZE_CLEAR: Set to "true" to clear caches before rebuilding them
# SCOUT_AUTO_DETECT: Set to "false" to disable Scout driver auto-detection
# PULSE_AUTO_CREATE_DATABASE: Create a missing PostgreSQL Pulse database. Default "true".
# PULSE_RUN_MIGRATIONS: Run the Pulse migration against its own connection. Default "true".
# PULSE_PURGE_ON_START: Drain pending ingest records and clear Pulse storage before boot. Default "true".
run_migrations=${RUN_MIGRATIONS:-"false"}
production_seeders=${PRODUCTION_SEEDERS:-""}
run_docker_scripts=${RUN_DOCKER_SCRIPTS:-"false"}
run_scout_settings=${RUN_SCOUT_SETTINGS:-"true"}
run_optimize=${RUN_OPTIMIZE:-"foreground"}
force_optimize_clear=${FORCE_OPTIMIZE_CLEAR:-"false"}
scout_auto_detect=${SCOUT_AUTO_DETECT:-"true"}
pulse_auto_create_database=${PULSE_AUTO_CREATE_DATABASE:-"true"}
pulse_run_migrations=${PULSE_RUN_MIGRATIONS:-"true"}
pulse_purge_on_start=${PULSE_PURGE_ON_START:-"true"}

# Back-compat: legacy RUN_SCOUT_INDEX=false still disables the remaining Scout
# settings sync. Truthy values no longer trigger a full import at startup.
if [ -n "${RUN_SCOUT_INDEX:-}" ]; then
    case "${RUN_SCOUT_INDEX}" in
        true|1|yes)
            run_scout_settings="true"
            ;;
        false|0|no|off|skip)
            run_scout_settings="false"
            ;;
    esac
fi
connection_max_tries=${CONNECTION_MAX_TRIES:-"30"}
connection_retry_sleep=${CONNECTION_RETRY_SLEEP:-"1"}
service_connect_timeout=${SERVICE_CONNECT_TIMEOUT:-"2"}

log_section() {
    echo ""
    echo "==> $1"
}

purge_laravel_provider_caches() {
    # Remove potentially stale discovery/optimize artifacts committed or copied
    # from another environment (for example, local dev with extra packages).
    # These files are safe to regenerate and can reference providers that are
    # not installed in the current container image.
    rm -f bootstrap/cache/*.php
}

is_primary_container() {
    [ "${container_mode}" = "http" ]
}

is_truthy() {
    case "${1:-}" in
        true|1|yes|on)
            return 0
            ;;
    esac

    return 1
}

is_falsy() {
    case "${1:-}" in
        false|0|no|off)
            return 0
            ;;
    esac

    return 1
}

resolve_station_enabled() {
    queue_connection=$(printf '%s' "${QUEUE_CONNECTION:-database}" | tr '[:upper:]' '[:lower:]')
    station_env=$(printf '%s' "${STATION_ENABLED:-}" | tr '[:upper:]' '[:lower:]')

    if [ "${queue_connection}" = "redis" ]; then
        station_enabled=true
        return 0
    fi

    if is_truthy "${station_env}"; then
        station_enabled=true
        return 0
    fi

    if is_falsy "${station_env}"; then
        station_enabled=false
        return 0
    fi

    station_enabled=false
}

is_redis_required() {
    queue_connection=$(printf '%s' "${QUEUE_CONNECTION:-database}" | tr '[:upper:]' '[:lower:]')
    cache_store=$(printf '%s' "${CACHE_STORE:-database}" | tr '[:upper:]' '[:lower:]')
    session_driver=$(printf '%s' "${SESSION_DRIVER:-database}" | tr '[:upper:]' '[:lower:]')

    if [ "${queue_connection}" = "redis" ] || [ "${queue_connection}" = "redis-pdf" ]; then
        return 0
    fi

    if [ "${cache_store}" = "redis" ] || [ "${session_driver}" = "redis" ]; then
        return 0
    fi

    return 1
}

resolve_database_connection() {
    if [ -n "${database_connection}" ]; then
        return 0
    fi

    derived_connection=$(php -r '
        $app = require "bootstrap/app.php";
        $kernel = $app->make(Illuminate\Contracts\Console\Kernel::class);
        $kernel->bootstrap();
        $driver = (string) config("database.default", "");
        echo strtolower($driver);
    ' 2>/dev/null || true)

    if [ -n "${derived_connection}" ]; then
        database_connection=$(printf '%s' "${derived_connection}" | tr '[:upper:]' '[:lower:]')
        export DB_CONNECTION="${database_connection}"
        return 0
    fi

    database_connection="sqlite"
    export DB_CONNECTION="${database_connection}"
}

is_database_connection_networked() {
    case "${database_connection}" in
        mysql|mariadb|pgsql|sqlsrv)
            return 0
            ;;
        sqlite)
            return 1
            ;;
    esac

    return 1
}

configure_database_connection_defaults() {
    case "${database_connection}" in
        mysql|mariadb)
            DB_HOST="${DB_HOST:-mysql}"
            DB_PORT="${DB_PORT:-3306}"
            ;;
        pgsql)
            DB_HOST="${DB_HOST:-pgsql}"
            DB_PORT="${DB_PORT:-5432}"
            ;;
        sqlsrv)
            DB_HOST="${DB_HOST:-sqlsrv}"
            DB_PORT="${DB_PORT:-1433}"
            ;;
    esac

    export DB_HOST DB_PORT DB_CONNECTION="${database_connection}"
}

configure_pulse_database_defaults() {
    pulse_database_driver=$(printf '%s' "${PULSE_DB_DRIVER:-${database_connection}}" | tr '[:upper:]' '[:lower:]')

    export PULSE_DB_CONNECTION="${PULSE_DB_CONNECTION:-pulse}"
    export PULSE_DB_DRIVER="${pulse_database_driver}"
    export PULSE_DB_HOST="${PULSE_DB_HOST:-${DB_HOST:-pgsql}}"
    export PULSE_DB_PORT="${PULSE_DB_PORT:-${DB_PORT:-5432}}"
    export PULSE_DB_USERNAME="${PULSE_DB_USERNAME:-${DB_USERNAME:-}}"
    export PULSE_DB_PASSWORD="${PULSE_DB_PASSWORD:-${DB_PASSWORD:-}}"

    if [ -z "${PULSE_DB_DATABASE:-}" ]; then
        if [ "${pulse_database_driver}" = "sqlite" ]; then
            PULSE_DB_DATABASE="database/pulse.sqlite"
        else
            PULSE_DB_DATABASE="${DB_DATABASE:-laravel}_pulse"
        fi

        export PULSE_DB_DATABASE
    fi
}

check_pulse_database_connection() {
    echo "Testing Pulse database connection to ${PULSE_DB_HOST}:${PULSE_DB_PORT}/${PULSE_DB_DATABASE}..."

    PGPASSWORD="${PULSE_DB_PASSWORD}" psql \
        --host="${PULSE_DB_HOST}" \
        --port="${PULSE_DB_PORT}" \
        --username="${PULSE_DB_USERNAME}" \
        --dbname="${PULSE_DB_DATABASE}" \
        --no-password \
        --tuples-only \
        --command='SELECT 1' >/dev/null 2>&1
}

ensure_pulse_database() {
    if ! is_truthy "${PULSE_ENABLED:-true}"; then
        echo "Pulse is disabled, skipping Pulse database setup."
        return 0
    fi

    if [ "${PULSE_STORAGE_DRIVER:-database}" != "database" ]; then
        echo "Pulse storage driver is not database, skipping Pulse database setup."
        return 0
    fi

    if [ "${PULSE_DB_CONNECTION}" != "pulse" ]; then
        echo "Pulse uses custom connection ${PULSE_DB_CONNECTION}; skipping automatic database creation."
        return 0
    fi

    if [ "${pulse_database_driver}" = "sqlite" ]; then
        mkdir -p "$(dirname "${PULSE_DB_DATABASE}")"
        touch "${PULSE_DB_DATABASE}"
        return 0
    fi

    if [ "${pulse_database_driver}" != "pgsql" ]; then
        echo "Pulse automatic database creation only supports PostgreSQL; expecting ${PULSE_DB_DATABASE} to exist."
        return 0
    fi

    if [ -z "${PULSE_DB_DATABASE}" ] || [ -z "${PULSE_DB_USERNAME}" ]; then
        echo "PULSE_DB_DATABASE and PULSE_DB_USERNAME are required." >&2
        return 1
    fi

    if check_pulse_database_connection; then
        echo "Pulse database connection successful."
        return 0
    fi

    if ! is_truthy "${pulse_auto_create_database}"; then
        echo "Pulse database is unavailable and PULSE_AUTO_CREATE_DATABASE is disabled." >&2
        return 1
    fi

    echo "Creating Pulse database ${PULSE_DB_DATABASE}..."

    PGPASSWORD="${PULSE_DB_PASSWORD}" createdb \
        --host="${PULSE_DB_HOST}" \
        --port="${PULSE_DB_PORT}" \
        --username="${PULSE_DB_USERNAME}" \
        --maintenance-db="${PULSE_DB_MAINTENANCE_DATABASE:-postgres}" \
        "${PULSE_DB_DATABASE}" >/dev/null 2>&1 || true

    if ! check_pulse_database_connection; then
        echo "Unable to create or connect to Pulse database ${PULSE_DB_DATABASE}." >&2
        return 1
    fi

    echo "Pulse database is ready."
}

is_http_url_reachable() {
    php -r "
        \$url = \$argv[1] ?? '';
        \$timeout = (float) (\$argv[2] ?? '2');

        if (\$url === '') {
            exit(1);
        }

        \$healthUrl = rtrim(\$url, '/') . '/health';
        \$context = stream_context_create([
            'http' => [
                'timeout' => \$timeout,
                'ignore_errors' => true,
            ],
        ]);

        \$response = @file_get_contents(\$healthUrl, false, \$context);

        if (\$response === false) {
            exit(1);
        }

        exit(0);
    " "$1" "${service_connect_timeout}"
}

configure_scout_driver() {
    resolved_scout_driver="${SCOUT_DRIVER:-}"

    if [ "${scout_auto_detect}" != "true" ]; then
        if [ -z "${resolved_scout_driver}" ]; then
            export SCOUT_DRIVER="collection"
        fi

        echo "Scout driver: ${SCOUT_DRIVER}"
        return 0
    fi

    if [ -z "${resolved_scout_driver}" ] || [ "${resolved_scout_driver}" = "collection" ] || [ "${resolved_scout_driver}" = "null" ]; then
        meilisearch_host="${MEILISEARCH_HOST:-}"

        if [ -n "${meilisearch_host}" ] && is_http_url_reachable "${meilisearch_host}"; then
            resolved_scout_driver="meilisearch"
        elif is_http_url_reachable "http://meilisearch:7700"; then
            resolved_scout_driver="meilisearch"
            meilisearch_host="http://meilisearch:7700"
        elif [ -n "${TYPESENSE_HOST:-}" ] && [ -n "${TYPESENSE_API_KEY:-}" ]; then
            resolved_scout_driver="typesense"
        elif [ -n "${ALGOLIA_APP_ID:-}" ] && [ -n "${ALGOLIA_SECRET:-}" ]; then
            resolved_scout_driver="algolia"
        else
            resolved_scout_driver="${resolved_scout_driver:-collection}"
        fi

        if [ "${resolved_scout_driver}" = "meilisearch" ] && [ -n "${meilisearch_host}" ]; then
            export MEILISEARCH_HOST="${meilisearch_host}"
        fi

        export SCOUT_DRIVER="${resolved_scout_driver}"
    fi

    echo "Scout driver: ${SCOUT_DRIVER}"

    if [ "${SCOUT_DRIVER}" = "meilisearch" ]; then
        echo "Meilisearch host: ${MEILISEARCH_HOST:-unset}"
    fi
}

check_redis_connection() {
    REDIS_HOST="${REDIS_HOST:-redis}"
    REDIS_PORT="${REDIS_PORT:-6379}"
    export REDIS_HOST REDIS_PORT

    echo "Testing Redis connection to ${REDIS_HOST}:${REDIS_PORT}..."

    php -r "
        \$maxTries = (int) getenv('CONNECTION_MAX_TRIES');
        \$retrySleep = (int) getenv('CONNECTION_RETRY_SLEEP');
        \$timeout = (float) getenv('SERVICE_CONNECT_TIMEOUT');

        for (\$i = 0; \$i < \$maxTries; \$i++) {
            try {
                \$redis = new Redis();
                \$redis->connect(getenv('REDIS_HOST'), (int) getenv('REDIS_PORT'), \$timeout);

                if (\$redis->ping()) {
                    echo 'Redis connection successful.' . PHP_EOL;
                    exit(0);
                }
            } catch (Throwable \$exception) {
            }

            sleep(\$retrySleep);
        }

        echo 'Failed to connect to Redis.' . PHP_EOL;
        exit(1);
    "
}

check_database_connection() {
    configure_database_connection_defaults

    echo "Testing Database connection to ${DB_HOST}:${DB_PORT}..."

    if [ -z "${DB_DATABASE:-}" ] || [ -z "${DB_USERNAME:-}" ]; then
        echo "Skipping Database check (DB_DATABASE/DB_USERNAME not set in environment)."
        return 0
    fi

    php -r "
        \$maxTries = (int) getenv('CONNECTION_MAX_TRIES');
        \$retrySleep = (int) getenv('CONNECTION_RETRY_SLEEP');
        \$timeout = (float) getenv('SERVICE_CONNECT_TIMEOUT');

        for (\$i = 0; \$i < \$maxTries; \$i++) {
            try {
                \$driver = getenv('DB_CONNECTION') ?: 'pgsql';
                \$connectTimeout = max(1, (int) ceil(\$timeout));
                \$options = [];

                if (\$driver === 'mysql' || \$driver === 'mariadb') {
                    \$dsn = sprintf(
                        'mysql:host=%s;port=%s;dbname=%s',
                        getenv('DB_HOST'),
                        getenv('DB_PORT'),
                        getenv('DB_DATABASE')
                    );
                    \$options = [PDO::ATTR_TIMEOUT => \$connectTimeout];
                } elseif (\$driver === 'sqlsrv') {
                    \$dsn = sprintf(
                        'sqlsrv:Server=%s,%s;Database=%s;LoginTimeout=%d',
                        getenv('DB_HOST'),
                        getenv('DB_PORT'),
                        getenv('DB_DATABASE'),
                        \$connectTimeout
                    );
                } else {
                    \$dsn = sprintf(
                        'pgsql:host=%s;port=%s;dbname=%s;connect_timeout=%d',
                        getenv('DB_HOST'),
                        getenv('DB_PORT'),
                        getenv('DB_DATABASE'),
                        \$connectTimeout
                    );
                }

                new PDO(\$dsn, getenv('DB_USERNAME'), getenv('DB_PASSWORD'), \$options);
                echo 'Database connection successful.' . PHP_EOL;
                exit(0);
            } catch (Throwable \$exception) {
            }

            sleep(\$retrySleep);
        }

        echo 'Failed to connect to Database.' . PHP_EOL;
        exit(1);
    "
}

check_storage_permissions() {
    echo "Testing Storage permissions..."

    php -r "
        \$path = 'storage/framework/testing/connection_test';
        @mkdir(dirname(\$path), 0777, true);

        if (@file_put_contents(\$path, 'test') !== false && @unlink(\$path)) {
            echo 'Storage is writable and readable.' . PHP_EOL;
            exit(0);
        }

        echo 'Storage is NOT writable or readable.' . PHP_EOL;
        exit(1);
    "
}

fix_storage_permissions() {
    echo "Fixing storage and cache permissions..."

    web_user="${WEB_USER:-${USER:-www-data}}"
    web_group="${WEB_GROUP:-${USER:-www-data}}"

    mkdir -p storage/framework/{cache,sessions,testing,views} storage/logs bootstrap/cache

    if [ "$(id -u)" = "0" ]; then
        chown -R "${web_user}:${web_group}" storage bootstrap/cache 2>/dev/null || true
    fi

    chmod -R 775 storage bootstrap/cache 2>/dev/null || true

    echo "Storage and cache permissions fixed."
}

check_opcache_directory() {
    echo "Testing OPcache directory..."

    php -r "
        \$opcacheDir = '/tmp/opcache-file-cache';

        if (! is_dir(\$opcacheDir)) {
            mkdir(\$opcacheDir, 0777, true);
        }

        if (is_dir(\$opcacheDir) && is_writable(\$opcacheDir)) {
            echo 'OPcache directory is accessible and writable.' . PHP_EOL;
            exit(0);
        }

        echo 'OPcache directory is NOT accessible or writable.' . PHP_EOL;
        exit(1);
    "
}

check_connections() {
    log_section "Checking dependencies"

    export CONNECTION_MAX_TRIES="${connection_max_tries}"
    export CONNECTION_RETRY_SLEEP="${connection_retry_sleep}"
    export SERVICE_CONNECT_TIMEOUT="${service_connect_timeout}"

    if is_redis_required; then
        check_redis_connection
    else
        echo "Skipping Redis check (no Redis-backed services configured)."
    fi

    if is_database_connection_networked; then
        check_database_connection
    else
        echo "Skipping Database network check (DB_CONNECTION=${database_connection})."
    fi

    check_storage_permissions
    check_opcache_directory
}

ensure_storage_link() {
    if [ -e "public/storage" ] || [ -L "public/storage" ]; then
        echo "Storage link already exists, skipping."
        return 0
    fi

    php artisan storage:link
}

ensure_vendor_view_dirs() {
    if [ -d "vendor/moataz-01/filament-notification-sound" ]; then
        mkdir -p "vendor/moataz-01/filament-notification-sound/resources/views"
    fi

    if [ -d "vendor/alizharb/laravel-modular" ]; then
        mkdir -p "vendor/alizharb/laravel-modular/resources/views"
    fi

    if [ -d "Modules" ]; then
        for module_dir in Modules/*; do
            if [ -d "${module_dir}/resources" ]; then
                mkdir -p "${module_dir}/resources/views"
            fi
        done
    fi
}

run_production_seeders() {
    if [ -z "${production_seeders}" ]; then
        return 0
    fi

    echo "Running production seeders: ${production_seeders}"

    printf '%s' "${production_seeders}" | tr ',' '\n' | while IFS= read -r seeder; do
        seeder=$(echo "${seeder}" | xargs)

        if [ -n "${seeder}" ]; then
            echo "  Running seeder: ${seeder}"
            php artisan db:seed --class="${seeder}" --force --no-interaction
        fi
    done

    echo "Production seeders completed."
}

run_migrations_if_enabled() {
    if [ "${run_migrations}" != "true" ]; then
        echo "Database migrations disabled, skipping."
        return 0
    fi

    echo "Running database migrations..."

    if [ "${app_env}" = "demo" ]; then
        php artisan migrate --seed --force --no-interaction
    else
        php artisan migrate --force --no-interaction
    fi

    echo "Migrations completed successfully."

    run_production_seeders
}

prepare_pulse_storage() {
    if ! is_truthy "${PULSE_ENABLED:-true}"; then
        return 0
    fi

    if [ "${PULSE_STORAGE_DRIVER:-database}" != "database" ]; then
        echo "Pulse storage is not database-backed, skipping database preparation."
        return 0
    fi

    log_section "Preparing Laravel Pulse"

    ensure_pulse_database

    if is_truthy "${pulse_run_migrations}"; then
        echo "Running Pulse migrations on ${PULSE_DB_CONNECTION}..."

        php artisan migrate \
            --database="${PULSE_DB_CONNECTION}" \
            --path=database/migrations/2026_03_09_105911_create_pulse_tables.php \
            --force \
            --no-interaction || {
                echo "Pulse migration was interrupted; retrying once."
                sleep 2
                php artisan migrate \
                    --database="${PULSE_DB_CONNECTION}" \
                    --path=database/migrations/2026_03_09_105911_create_pulse_tables.php \
                    --force \
                    --no-interaction
            }
    else
        echo "Pulse migrations disabled, skipping."
    fi

    if ! is_truthy "${pulse_purge_on_start}"; then
        echo "Pulse startup purge disabled, preserving existing data."
        return 0
    fi

    if [ "${PULSE_INGEST_DRIVER:-storage}" = "redis" ]; then
        echo "Draining pending Pulse Redis ingest data before purge..."
        php artisan pulse:work --stop-when-empty --no-interaction
    fi

    echo "Purging existing Pulse data..."
    php artisan pulse:clear --force --no-interaction
    echo "Pulse storage is ready."
}

run_docker_scripts_if_enabled() {
    if [ "${run_docker_scripts}" != "true" ]; then
        return 0
    fi

    echo "Running Docker setup scripts..."
    /usr/local/bin/run-scripts.sh run
    echo "Docker scripts completed."
}

scout_needs_external_index() {
    case "${SCOUT_DRIVER}" in
        database|collection|null|"")
            return 1
            ;;
    esac
    return 0
}

run_scout_settings_sync() {
    if [ "${run_scout_settings}" != "true" ]; then
        return 0
    fi

    if ! scout_needs_external_index; then
        echo "Scout driver ${SCOUT_DRIVER:-unset} does not require index settings sync."
        return 0
    fi

    echo "Syncing Scout index settings (${SCOUT_DRIVER})..."
    php artisan scout:sync-index-settings --no-interaction || {
        echo "WARN: scout:sync-index-settings failed; continuing startup."
    }
}

run_optimize_foreground() {
    if [ "${force_optimize_clear}" = "true" ]; then
        php artisan optimize:clear || {
            echo "WARN: optimize:clear failed; continuing startup."
        }
    fi

    php artisan optimize || {
        echo "WARN: php artisan optimize failed; continuing startup without refreshed caches."
    }
}

schedule_optimize_background() {
    echo "Scheduling Laravel optimize in background..."
    (
        sleep 5
        if [ "${force_optimize_clear}" = "true" ]; then
            php artisan optimize:clear
        fi
        php artisan optimize \
            && echo "[optimize-bg] optimize completed at $(date -Iseconds)" \
            || echo "[optimize-bg] optimize FAILED at $(date -Iseconds)"
    ) >/proc/1/fd/1 2>&1 </dev/null &
    disown 2>/dev/null || true
}

dispatch_optimize() {
    case "${run_optimize}" in
        foreground|true|1|yes)
            run_optimize_foreground
            ;;
        background|bg|async)
            schedule_optimize_background
            ;;
        false|0|no|off|skip|"")
            echo "Laravel optimize step disabled, skipping."
            ;;
        *)
            echo "Unknown RUN_OPTIMIZE=${run_optimize}, running in foreground."
            run_optimize_foreground
            ;;
    esac
}

run_primary_startup_tasks() {
    log_section "Running primary container startup tasks"

    ensure_storage_link
    ensure_vendor_view_dirs
    prepare_pulse_storage
    run_migrations_if_enabled
    run_docker_scripts_if_enabled
    dispatch_optimize
    schedule_scout_settings_post_start
}

bootstrap_container() {
    echo "Container mode: ${container_mode}"

    resolve_station_enabled
    echo "Station enabled: ${station_enabled}"

    fix_storage_permissions
    purge_laravel_provider_caches
    resolve_database_connection
    configure_database_connection_defaults
    configure_pulse_database_defaults
    echo "Database connection driver: ${database_connection}"
    check_connections
    configure_scout_driver

    if is_primary_container; then
        run_primary_startup_tasks
    fi
}

start_http_container() {
    echo "Octane Server: ${octane_server}"

    # Ensure any files created during startup (logs, caches, etc.) are
    # writable by the web server process before it starts.
    fix_storage_permissions

    if [ "${octane_server}" = "frankenphp" ]; then
        if [ "${station_enabled}" = "true" ]; then
            exec /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.frankenphp.conf
        fi

        exec /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.frankenphp.no-station.conf
    elif [ "${octane_server}" = "swoole" ]; then
        exec /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.swoole.conf
    elif [ "${octane_server}" = "roadrunner" ]; then
        exec /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.roadrunner.conf
    fi

    echo "Invalid Octane server supplied."
    exit 1
}

start_non_http_container() {
    if [ "${container_mode}" = "station" ]; then
        if [ "${station_enabled}" != "true" ]; then
            echo "CONTAINER_MODE=station requested but Station is disabled for queue driver '${QUEUE_CONNECTION:-database}'."
            exit 0
        fi

        exec /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.station.conf
    elif [ "${container_mode}" = "reverb" ]; then
        exec /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.reverb.conf
    elif [ "${container_mode}" = "scheduler" ]; then
        exec /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.scheduler.conf
    elif [ "${container_mode}" = "nightwatch" ]; then
        exec /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.nightwatch.conf
    elif [ "${container_mode}" = "worker" ]; then
        if [ -z "${WORKER_COMMAND:-}" ]; then
            echo "WORKER_COMMAND is undefined."
            exit 1
        fi

        exec /usr/bin/supervisord -n -c /etc/supervisor/conf.d/supervisord.worker.conf
    fi

    echo "Container mode mismatched."
    exit 1
}

if [ "$1" != "" ]; then
    exec "$@"
fi

bootstrap_container

if is_primary_container; then
    start_http_container
fi

start_non_http_container
