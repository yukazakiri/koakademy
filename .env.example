# =============================================================================
# KoAkademy Development Environment Configuration
# =============================================================================
# Copy this file to .env and configure for your development environment

# Note: For Docker Compose environments:
# - Use service names (e.g., 'pgsql', 'redis') for container-to-container communication
# - Use 'localhost' or '127.0.0.1' for direct local access

# Application Settings
APP_NAME="KoAkademy"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Application URL - Set to your local domain
APP_URL=http://localhost

# Generate with: php artisan key:generate --show
APP_KEY=

# ======================== DATABASE ========================
DB_CONNECTION=sqlite
# DB_HOST=pgsql
# DB_PORT=5432
# DB_DATABASE=koakademy
# DB_USERNAME=sail
# DB_PASSWORD=
# DB_DATABASE_TESTING=koakademy-testing
# AUTO_MIGRATE=true

# ======================== CACHE & REDIS ========================
CACHE_STORE=database
CACHE_PREFIX=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_PDF_QUEUE_DB=3
REDIS_PULSE_DB=4
REDIS_ASSESSMENT_QUEUE_DB=5

REDIS_QUEUE_RETRY_AFTER=90
REDIS_PDF_QUEUE_RETRY_AFTER=7200
ASSESSMENT_EXPORT_CONNECTION=assessment-pdf
ASSESSMENT_EXPORT_QUEUE=assessment-pdf
ASSESSMENT_EXPORT_EVENT_QUEUE=assessment-events
ASSESSMENT_EXPORT_RETRY_AFTER=2400
ASSESSMENT_EXPORT_BLOCK_FOR=5
ASSESSMENT_EXPORT_PROCESSES=2
ASSESSMENT_EXPORT_EVENT_PROCESSES=1
ASSESSMENT_EXPORT_WORKER_TIMEOUT=1900
ASSESSMENT_EXPORT_WORKER_MEMORY=2048
ASSESSMENT_EXPORT_DISK=local
ASSESSMENT_EXPORT_STUDENT_LIMITS=10,25,50,100,250,500
ASSESSMENT_EXPORT_PREPARE_TIMEOUT=300
ASSESSMENT_EXPORT_PREPARE_TRIES=2
ASSESSMENT_EXPORT_PREPARE_BACKOFF=15,60
ASSESSMENT_EXPORT_RENDER_TIMEOUT=600
ASSESSMENT_EXPORT_RENDER_TRIES=3
ASSESSMENT_EXPORT_RENDER_BACKOFF=30,120,300
ASSESSMENT_EXPORT_MERGE_TIMEOUT=1800
ASSESSMENT_EXPORT_MERGE_TRIES=2
ASSESSMENT_EXPORT_MERGE_BACKOFF=60,300
ASSESSMENT_EXPORT_MERGE_FAN_IN=20
ASSESSMENT_EXPORT_MAX_ACTIVE_PER_USER=1
ASSESSMENT_EXPORT_BROADCAST_THROTTLE_MS=0
ASSESSMENT_EXPORT_TERMINAL_VISIBLE_MINUTES=15
ASSESSMENT_EXPORT_INTERMEDIATE_HOURS=24
ASSESSMENT_EXPORT_FINAL_DAYS=30
ASSESSMENT_EXPORT_METADATA_DAYS=90

# ======================== QUEUE ========================
# Keep Redis as the queue backend; Horizon manages the workers.
QUEUE_CONNECTION=redis

# ======================== MAIL ========================
# Development: Use 'log' or 'mailpit'
# Mailpit UI: http://mailpit.local.test:8025
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=info@koakademy.edu
MAIL_FROM_NAME="${APP_NAME}"

# Sequenzy REST transport (set MAIL_MAILER=sequenzy to enable globally)
SEQUENZY_API_KEY=
SEQUENZY_API_URL=https://api.sequenzy.com/api/v1/transactional/send
SEQUENZY_API_BASE_URL=https://api.sequenzy.com/api/v1
SEQUENZY_TIMEOUT=15

# ======================== BROADCASTING & REALTIME ========================
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log
PUSHER_APP_ID="1801608"
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER="ap1"
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ======================== FILE STORAGE ========================
# MinIO Configuration (for S3-like local storage)
# MinIO: http://minio.local.test:9000
# MinIO Console: http://minio-console.local.test:8900
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=koakademy
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:9000/koakademy

# Private Digital Library storage. Keep this bucket private and separate from
# any bucket or custom domain used for public uploads.
LIBRARY_EBOOK_DRIVER=local
LIBRARY_EBOOK_MAX_KB=92160
LIBRARY_READER_URL_MINUTES=60
LIBRARY_DOWNLOAD_URL_MINUTES=5
LIBRARY_TAKEDOWN_EMAIL=
LIBRARY_R2_ACCESS_KEY_ID=
LIBRARY_R2_SECRET_ACCESS_KEY=
LIBRARY_R2_DEFAULT_REGION=auto
LIBRARY_R2_BUCKET=
LIBRARY_R2_ENDPOINT=

# ======================== PDF RENDERING ========================
# Using Cloudflare Browser Rendering (headless Chrome via API)
# https://spatie.be/docs/laravel-pdf/v2/drivers/using-the-cloudflare-driver
LARAVEL_PDF_DRIVER=cloudflare
LARAVEL_PDF_PRODUCTION_DRIVER=cloudflare
LARAVEL_PDF_STAGING_DRIVER=cloudflare
LARAVEL_PDF_LOCAL_DRIVER=cloudflare

# Fallback order by environment profile
LARAVEL_PDF_PRODUCTION_FALLBACK=dompdf
LARAVEL_PDF_STAGING_FALLBACK=dompdf
LARAVEL_PDF_LOCAL_FALLBACK=dompdf

# Rollback target if remote rendering provider is unavailable
LARAVEL_PDF_ROLLBACK_DRIVER=dompdf

# Cloudflare Browser Rendering credentials (required for cloudflare driver)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ======================== IMAGE PROCESSING ========================
# Leave empty to use autodiscovery or configure for external headless Chrome
CHROME_BIN=
CHROME_ARGS="--no-sandbox --disable-dev-shm-usage --disable-gpu --headless --disable-extensions"
IMAGE_DRIVER=gd
IMAGE_QUALITY=90
IMAGE_ALLOW_SVG=true

# ======================== LOGGING ========================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
ACTIVITY_LOG_ENABLED=true
DEBUGBAR_ENABLED=true

# ======================== LARAVEL OCTANE & FRANKENPHP ========================
OCTANE_SERVER=frankenphp
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=500
OCTANE_LOG_LEVEL=info
OCTANE_HTTPS=false

# ======================== DEBUGGING ========================
# Xdebug Configuration
SAIL_XDEBUG_MODE=off
SAIL_XDEBUG_CONFIG=client_host=127.0.0.1

# Feature Flags
TELESCOPE_ENABLED=true
TELESCOPE_ONLY_LOCALHOST=false
HORIZON_ENABLED=true
HORIZON_PROCESSES=3
HORIZON_MEMORY=512
HORIZON_TIMEOUT=60
HORIZON_PDF_PROCESSES=2
HORIZON_PDF_MEMORY=2048
HORIZON_PDF_TIMEOUT=3600
PULSE_ENABLED=true
PULSE_INGEST_DRIVER=redis
PULSE_REDIS_CONNECTION=pulse
PULSE_STORAGE_DRIVER=database
PULSE_DB_CONNECTION=pulse
# Defaults to the primary PostgreSQL server with a separate <DB_DATABASE>_pulse database.
# Override these when Pulse has its own PostgreSQL service or credentials.
# PULSE_DB_DRIVER=pgsql
# PULSE_DB_HOST=pgsql
# PULSE_DB_PORT=5432
# PULSE_DB_DATABASE=koakademy_pulse
# PULSE_DB_USERNAME=sail
# PULSE_DB_PASSWORD=
PULSE_AUTO_CREATE_DATABASE=true
PULSE_RUN_MIGRATIONS=true
PULSE_PURGE_ON_START=true

# ======================== DOCKER COMPOSE ========================
WWWGROUP=1000
WWWUSER=1000
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_MINIO_PORT=9000
FORWARD_MINIO_CONSOLE_PORT=8900
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
VITE_PORT=5173

# ======================== LOCAL DOMAINS ========================
# These domains are configured in Traefik and /etc/hosts
# After setup, these should be accessible in your browser
PORTAL_HOST=localhost
ADMIN_HOST=admin.koakademy.test
MAILPIT_HOST=mailpit.local.test
MINIO_HOST=minio.local.test
MINIO_CONSOLE_HOST=minio-console.local.test

# ======================== VITE ========================
VITE_APP_NAME="${APP_NAME}"
DOCUMENTATION_URL=https://koakademy.github.io/koakademy

# ======================== ONBOARDING ========================
ONBOARDING_FORCE_ON_LOGIN=false

# ======================== API & INTEGRATIONS ========================
RESEND_API_KEY=
GITHUB_REPOSITORY=yukazakiri/koakademy
GITHUB_TOKEN=

# ======================== SANITY CMS ========================
# Sanity Headless CMS Configuration
# Get these values from your Sanity project at https://www.sanity.io/manage
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_API_VERSION=2023-05-03
SANITY_USE_CDN=false

# ======================== API ENDPOINT ========================
API_SERVICE_HOST=http://localhost
API_SERVICE_TIMEOUT=30
