<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature Tests">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Unit Tests">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>app/Filament</directory>
            <directory>app/Settings</directory>
        </exclude>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <server name="APP_ENV" value="testing"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <server name="SCOUT_DRIVER" value="collection"/>
        <server name="PULSE_ENABLED" value="false"/>
        <server name="PULSE_DB_CONNECTION" value="sqlite"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="NIGHTWATCH_ENABLED" value="false"/>
        <server name="SIMPLESTATS_ENABLED" value="false"/>
        <server name="LARAVEL_PDF_DRIVER" value="gotenberg"/>
        <server name="LARAVEL_PDF_PRODUCTION_DRIVER" value="gotenberg"/>
        <server name="LARAVEL_PDF_STAGING_DRIVER" value="gotenberg"/>
        <server name="LARAVEL_PDF_LOCAL_DRIVER" value="gotenberg"/>
        <server name="LARAVEL_PDF_PRODUCTION_FALLBACK" value=""/>
        <server name="LARAVEL_PDF_STAGING_FALLBACK" value=""/>
        <server name="LARAVEL_PDF_LOCAL_FALLBACK" value=""/>
        <server name="LARAVEL_PDF_ROLLBACK_DRIVER" value="gotenberg"/>
    </php>
</phpunit>
