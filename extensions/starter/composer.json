{
    "name": "koakademy/school-notes-starter",
    "version": "0.1.0",
    "description": "A working community extension starter for Koakademy.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.5.12 <8.6",
        "laravel/framework": "^13.0",
        "filament/filament": "^5.0",
        "nwidart/laravel-modules": "^13.0",
        "inertiajs/inertia-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Koakademy\\SchoolNotes\\": "app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Koakademy\\SchoolNotes\\Providers\\SchoolNotesServiceProvider"
            ]
        }
    }
}
