# KoAkademy production template for compose.production.yaml.
# Copy to .env, replace every change-me value, and generate APP_KEY with:
# docker compose -f compose.production.yaml run --rm app php artisan key:generate --show

# Pin an exact stable FrankenPHP release tag (for example, v1.30.0-franken)
# or override the full image reference via KOAKADEMY_IMAGE.
KOAKADEMY_VERSION=latest-franken
APP_NAME=KoAkademy
APP_ENV=production
APP_DEBUG=false
APP_KEY=change-me-generate-an-app-key
APP_URL=https://school.example
# After deployment, run `php artisan migrate --force` and generate the MCP
# OAuth signing keys once with `php artisan passport:keys`. Keep storage
# persistent and share the same keys across replicas. See the MCP docs.
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# The supported default is one HTTPS hostname; administration lives at /admin.
PORTAL_HOST=school.example
ADMIN_HOST=school.example
# Comma-separated additional exact hostnames. Do not enter regular expressions.
TRUSTED_HOSTS=
# Trust only explicit reverse-proxy IPs/CIDRs (e.g., local loopback or Docker edge subnet).
# Avoid '*' so untrusted internet clients cannot spoof X-Forwarded-* headers.
TRUSTED_PROXIES=127.0.0.1,::1
# Comma-separated browser origins allowed to call /api/* via CORS. Defaults to APP_URL.
CORS_ALLOWED_ORIGINS=https://school.example

APP_PORT=8000
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
OCTANE_WORKERS=2
OCTANE_MAX_REQUESTS=500
# Set to false on hardened deployments to hide /changelog and exact app version from unauthenticated visitors.
PUBLIC_CHANGELOG_ENABLED=true

# Maximum decoded request body size accepted at the edge, enforced by Caddy
# independently of PHP's post_max_size. Keep it in step with post_max_size
# unless you deliberately accept smaller uploads. Lowering it also reduces the
# memory a hostile multipart body can make a PHP worker allocate.
KOAKADEMY_MAX_REQUEST_BODY=420M

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=koakademy
DB_USERNAME=koakademy
DB_PASSWORD=change-me-database-password

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# Bounded Redis timeouts. The phpredis default for both is 0, which waits
# forever, so an unreachable Redis would hang a worker instead of failing
# the request. REDIS_READ_TIMEOUT must stay above the queue `block_for`
# values (5s), because the queue worker blocks on BLPOP for that long.
REDIS_TIMEOUT=3
REDIS_READ_TIMEOUT=10

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Must stay above the 300 second timeout of the student export and PDF jobs,
# or a second worker can start the same job while the first is still running.
REDIS_QUEUE_RETRY_AFTER=600

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

# Default to the persistent local app-storage volume for single-node evaluation.
# Switch FILESYSTEM_DISK=s3 (or r2) and configure the S3/R2 credentials below
# before multi-replica rollouts or production reliance.
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Generated exports (assessment forms, student lists, timetable PDFs) are written
# to this disk instead of FILESYSTEM_DISK, so they are never reachable through
# the public /storage path without authentication.
# The built-in "private" disk is local, so every replica has to share it.
# Point this at an S3/R2 disk when the deployment runs more than one replica.
FILESYSTEM_PRIVATE_DISK=private

# Use a separate private R2/S3 bucket for copyrighted digital editions.
# Do not configure a public URL or custom domain for this bucket.
LIBRARY_EBOOK_DRIVER=
LIBRARY_EBOOK_MAX_KB=92160
LIBRARY_READER_URL_MINUTES=60
LIBRARY_DOWNLOAD_URL_MINUTES=5
LIBRARY_TAKEDOWN_EMAIL=library@example.edu
LIBRARY_R2_ACCESS_KEY_ID=
LIBRARY_R2_SECRET_ACCESS_KEY=
LIBRARY_R2_DEFAULT_REGION=auto
LIBRARY_R2_BUCKET=
LIBRARY_R2_ENDPOINT=

# spatie/laravel-pdf uses the private Gotenberg service; DOMPDF is not installed.
LARAVEL_PDF_DRIVER=gotenberg
LARAVEL_PDF_PRODUCTION_DRIVER=gotenberg
LARAVEL_PDF_PRODUCTION_FALLBACK=
LARAVEL_PDF_ROLLBACK_DRIVER=gotenberg
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@school.example
MAIL_FROM_NAME="${APP_NAME}"
BROADCAST_CONNECTION=log

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# --- Authentication throttling ------------------------------------------------
# Limits applied to the unauthenticated sign-in surface. Raise the per-IP
# login limit when the school sits behind a shared campus network.
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_IP_RATE_LIMIT=30
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_TWO_FACTOR_RATE_LIMIT=10
AUTH_TWO_FACTOR_EMAIL_RATE_LIMIT=3
AUTH_TWO_FACTOR_MAX_ATTEMPTS=5
AUTH_PASSKEY_RATE_LIMIT=10
AUTH_MAGIC_LINK_RATE_LIMIT=5
AUTH_PASSWORD_RESET_RATE_LIMIT=5
AUTH_OTP_MAX_ATTEMPTS=5

# Database migrations run in the release step, before the application
# rollout. Set AUTO_MIGRATE=true only when unattended PaaS auto-deploys (such
# as Dokploy GitHub Auto Deploy) must migrate automatically on boot; with
# AUTO_MIGRATE_LOCK=true, booting replicas wait on a blocking migration lock
# instead of racing each other.
AUTO_MIGRATE=false
AUTO_MIGRATE_LOCK=true
MIGRATE_LOCK_TIMEOUT=300
RUN_DOCKER_SCRIPTS=false
RUN_SCOUT_SETTINGS=false
RUN_OPTIMIZE=foreground

HORIZON_ENABLED=true
HORIZON_IN_HTTP_CONTAINER=false
HORIZON_PROCESSES=2
HORIZON_PDF_PROCESSES=1
QUEUE_PREFORK=true
PULSE_ENABLED=false

# Zero-interruption updates: retain prior Vite build chunks in shared storage so
# open tabs never hit 404s during or after rollouts, and notify active Inertia
# sessions gently instead of forcing an abrupt 409 full-page reload mid-task.
RETAIN_PREVIOUS_BUILD_ASSETS=true
BUILD_ASSETS_RETENTION_DAYS=7
INERTIA_SOFT_VERSION_UPDATES=true
INERTIA_FORCE_RELOAD_VERSION=
APP_UPDATE_POLL_INTERVAL=300

# Laravel Nightwatch observability (third-party; opt-in).
# NIGHTWATCH_ENABLED must be true for the local agent to run and forward
# telemetry, and NIGHTWATCH_TOKEN is the ingest key from your Nightwatch site.
# Both must be set deliberately; a default install forwards nothing.
NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.0
NIGHTWATCH_EXCEPTION_SAMPLE_RATE=0.0
TELESCOPE_ENABLED=false
SCOUT_DRIVER=null

# Search index updates are queued so a save never waits on the search engine.
# Horizon drains the `scout` queue from the "supervisor-1" supervisor.
SCOUT_QUEUE=true
SCOUT_QUEUE_NAME=scout

# SimpleStats, third-party server-side funnel/revenue attribution (opt-in).
SIMPLESTATS_ENABLED=false
SIMPLESTATS_API_TOKEN=

# Laraowl telemetry (third-party; opt-in). Leave disabled unless configured.
LARAOWL_ENABLED=false

# Sentry error reporting (third-party; opt-in). Empty DSN keeps Sentry inert.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Vendor-installed Composer modules are scanned by default.
MODULE_SCAN_VENDOR=true

# Signed Composer/module catalog published by the public registry repository.
# For a container registry, replace the public key with the generated key from
# /data/keys/public.key and keep it in a deployment secret or mounted file.
MODULE_MARKETPLACE_ENABLED=true
MODULE_REGISTRY_URL=https://yukazakiri.github.io/koakademy-modules/registry.json
MODULE_REGISTRY_CACHE_TTL=3600
MODULE_REGISTRY_REQUIRE_SIGNATURE=true
MODULE_REGISTRY_PUBLIC_KEY=KCJJ_FC2iE_wABYvTlN9mAe-ShCj4bIN4CCcTqIKM8U
MODULE_REGISTRY_PUBLIC_KEY_FILE=

# Vendor public key for enterprise licenses; never configure a signing key here.
ENTERPRISE_LICENSE_PUBLIC_KEY=
# Persist administrator module choices outside the container image.
MODULE_STATUSES_FILE=/app/storage/app/modules_statuses.json
# Use "disabled" only for a brand-new installation; preserve existing choices on upgrades.
MODULE_DEFAULT_STATUS=preserve

VITE_APP_NAME="${APP_NAME}"

# --- AI provider endpoint security ------------------------------------------
# Public AI endpoints must use HTTPS. Allowlist self-hosted providers (private
# hosts or plain HTTP) explicitly. Cloud metadata endpoints stay blocked.
AI_ALLOWED_PRIVATE_HOSTS=
AI_MAX_RESPONSE_BYTES=2097152
