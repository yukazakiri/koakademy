#!/usr/bin/env bash
set -Eeuo pipefail

: "${KOAKADEMY_INSTALLER_TEST_STATE:?}"

state="$KOAKADEMY_INSTALLER_TEST_STATE"
mkdir -p "$state/services" "$state/secrets" "$state/configs"
if [[ -n "${KOAKADEMY_INSTALLER_TEST_LEGACY_SERVICE:-}" ]]; then
    : >"$state/services/${KOAKADEMY_INSTALLER_TEST_LEGACY_SERVICE}"
fi
printf '%s\n' "$*" >>"$state/docker.log"

exists() { [[ -e "$state/$1/$2" ]]; }
create() { : >"$state/$1/$2"; }

command_name="${1:-}"
shift || true

case "$command_name" in
    version) exit 0 ;;
    info)
        case "$*" in
            *'{{.OSType}}'*) printf 'linux\n' ;;
            *'{{.Architecture}}'*) printf '%s\n' "${KOAKADEMY_INSTALLER_TEST_ARCHITECTURE:-amd64}" ;;
            *'{{.Swarm.LocalNodeState}}'*) printf '%s\n' "${KOAKADEMY_INSTALLER_TEST_SWARM_STATE:-active}" ;;
            *'{{.Swarm.ControlAvailable}}'*) printf '%s\n' "${KOAKADEMY_INSTALLER_TEST_SWARM_MANAGER:-true}" ;;
            *'{{.Name}}'*) printf 'installer-test-manager\n' ;;
            *) exit 1 ;;
        esac
        ;;
    swarm)
        [[ "${1:-}" == init ]]
        create services swarm-initialized
        ;;
    secret|config)
        object="${command_name}s"
        action="${1:-}"
        shift || true
        if [[ "$action" == inspect ]]; then
            name="${*: -1}"
            exists "$object" "$name"
            exit
        fi
        [[ "$action" == create ]]
        name="${*: -2:1}"
        create "$object" "$name"
        ;;
    stack)
        [[ "${1:-}" == deploy ]]
        create services koakademy_postgres
        create services koakademy_redis
        create services koakademy_gotenberg
        create services koakademy_caddy
        if [[ "${APP_REPLICAS:-1}" != 0 ]]; then
            create services koakademy_app
            printf '%s\n' "${KOAKADEMY_IMAGE:-}" >"$state/services/koakademy_app_image"
        fi
        ;;
    ps)
        printf 'postgres-test-container\n'
        ;;
    exec)
        printf 'fixture-postgres-backup\n'
        ;;
    service)
        action="${1:-}"
        shift || true
        case "$action" in
            ls)
                find "$state/services" -maxdepth 1 -type f -printf '%f\n' | grep -v '^swarm-initialized$' || true
                ;;
            create)
                name=""
                previous=""
                for argument in "$@"; do
                    if [[ "$previous" == --name ]]; then name="$argument"; break; fi
                    previous="$argument"
                done
                [[ -n "$name" ]]
                create services "$name"
                ;;
            rm)
                rm -f "$state/services/${1:-}"
                ;;
            ps)
                name="$1"
                exists services "$name" || exit 1
                if [[ "$name" == koakademy-migrate-* || "$name" == koakademy-scout-* ]]; then
                    printf 'Complete\n'
                else
                    printf 'Running\n'
                fi
                ;;
            inspect)
                if [[ "$*" == *'UpdateStatus'* ]]; then
                    printf '\n'
                else
                    cat "$state/services/koakademy_app_image"
                fi
                ;;
            *) exit 1 ;;
        esac
        ;;
    *) exit 1 ;;
esac
