# KoAkademy production template for compose.production.yaml.
# Copy to .env, replace every change-me value, and generate APP_KEY with:
# docker compose -f compose.production.yaml run --rm app php artisan key:generate --show

KOAKADEMY_VERSION=change-me-stable-tag
APP_NAME=KoAkademy
APP_ENV=production
APP_DEBUG=false
APP_KEY=change-me-generate-an-app-key
APP_URL=https://school.example
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# The supported default is one HTTPS hostname; administration lives at /admin.
PORTAL_HOST=school.example
ADMIN_HOST=school.example
# Comma-separated additional exact hostnames. Do not enter regular expressions.
TRUSTED_HOSTS=
# The app is loopback-only in Compose, so only the local edge can supply headers.
# Replace * with proxy IPs/CIDRs if the application is exposed another way.
TRUSTED_PROXIES=*

APP_PORT=8000
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=500

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=koakademy
DB_USERNAME=koakademy
DB_PASSWORD=change-me-database-password

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
CACHE_STORE=redis
QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

# Production uploads require external S3-compatible object storage.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=change-me-access-key
AWS_SECRET_ACCESS_KEY=change-me-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=change-me-bucket
AWS_ENDPOINT=https://s3.example
AWS_URL=https://cdn.example
AWS_USE_PATH_STYLE_ENDPOINT=true

# Use a separate private R2/S3 bucket for copyrighted digital editions.
# Do not configure a public URL or custom domain for this bucket.
LIBRARY_EBOOK_DRIVER=s3
LIBRARY_EBOOK_MAX_KB=92160
LIBRARY_READER_URL_MINUTES=60
LIBRARY_DOWNLOAD_URL_MINUTES=5
LIBRARY_TAKEDOWN_EMAIL=library@example.edu
LIBRARY_R2_ACCESS_KEY_ID=change-me-library-access-key
LIBRARY_R2_SECRET_ACCESS_KEY=change-me-library-secret-key
LIBRARY_R2_DEFAULT_REGION=auto
LIBRARY_R2_BUCKET=change-me-private-library-bucket
LIBRARY_R2_ENDPOINT=https://change-me-account-id.r2.cloudflarestorage.com

# spatie/laravel-pdf uses the private Gotenberg service; DOMPDF is not installed.
LARAVEL_PDF_DRIVER=gotenberg
LARAVEL_PDF_PRODUCTION_DRIVER=gotenberg
LARAVEL_PDF_PRODUCTION_FALLBACK=
LARAVEL_PDF_ROLLBACK_DRIVER=gotenberg
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_USERNAME=
GOTENBERG_PASSWORD=

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@school.example
MAIL_FROM_NAME="${APP_NAME}"
BROADCAST_CONNECTION=log

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database changes are an explicit operator step; never migrate on app startup.
RUN_MIGRATIONS=false
RUN_DOCKER_SCRIPTS=false
RUN_SCOUT_SETTINGS=false
RUN_OPTIMIZE=foreground

HORIZON_ENABLED=true
HORIZON_PROCESSES=2
HORIZON_PDF_PROCESSES=1
PULSE_ENABLED=false
NIGHTWATCH_ENABLED=false
TELESCOPE_ENABLED=false
SCOUT_DRIVER=null
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

VITE_APP_NAME="${APP_NAME}"
